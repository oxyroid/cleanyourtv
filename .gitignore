tools/venv
tools/adbkey/
__pycache__/
launcher/.gradle/
launcher/build/
launcher/app/build/
launcher/local.properties
# your own TV's dumps (serial, android_id, device names) stay local
backup/
# session screenshots and working notes (may show the Wi-Fi name or account avatar) stay local
shots/
work/
# Perfetto traces from tools/trace.py: large, and they hold the TV's process list
traces/
# Results from tools/bench.py: result.json carries the address the run was given and the TV's fingerprint.
bench-results/
.DS_Store

# Generated install bundles and JVM crash reports stay out of contributions.
*.apk
*.aab
# Except the prebuilt rescue APK that ships with the Dangbei X9 Pro folder: the whole point of
# that folder's scout/ is that the set has no other way in (no Developer options, no adb, no
# store that works) - a reader with a bricked-ish unit cannot build the app first. The kido/
# folder is a submodule with its own dist/ and its own rules.
!examples/dangbei-x9-pro/scout/dist/*.apk
launcher/hs_err_pid*.log
launcher/replay_pid*.log
